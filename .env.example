# Copy this file to `.env` in the project root and fill in your own values. `.env` is gitignored.

# Zerodha Kite Connect (https://developers.kite.trade). The daily access token is produced by
#   .venv/bin/python -m pa_engine login
# and saved to Dependencies/kite_token_<date>.txt (gitignored); alternatively set KITE_ACCESS_TOKEN here.
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=

# Safety: the live runner refuses to place real orders unless this is explicitly false.
PAPER_TRADING=true

# Telegram alerts (optional): create a bot with @BotFather, message it once, read the chat id from getUpdates.
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
