# Copy this file to `.env` in the project root and fill in your own values.
# `.env` is gitignored - never commit real credentials.

# Dhan authentication: "pin_totp" (automated daily login), "access_token", or "api_key"
DHAN_AUTH_MODE=pin_totp
DHAN_CLIENT_ID=your_client_id_here
DHAN_PIN=your_6_digit_pin
DHAN_TOTP_SECRET=your_totp_secret
DHAN_ACCESS_TOKEN=your_access_token_here
STATIC_IP=

# Trading engine
PAPER_TRADING=true
LOG_LEVEL=INFO

# Telegram notifications (optional). ENABLE_TELEGRAM defaults to true for algo_vpin_v2, false for algo_vpin_dhan.
# ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini (optional, algo_vpin_v2 only)
GEMINI_API_KEY=
